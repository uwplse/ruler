(! (&& ?x (! ?y))) ==> (|| (! ?x) (!= ?y 0))
(|| (! ?x) (!= ?y 0)) ==> (! (&& ?x (! ?y)))
(min ?x (max ?x (max ?y ?z))) ==> ?x
(max ?x (min ?x (min ?y ?z))) ==> ?x
(&& (== ?x ?y) (== ?y ?x)) ==> (== ?x ?y)
(== ?x ?y) ==> (&& (== ?x ?y) (== ?y ?x))
(|| (== ?x ?y) (== ?y ?x)) ==> (== ?x ?y)
(== ?x ?y) ==> (|| (== ?x ?y) (== ?y ?x))
