(== ?x ?y) ==> (&& (<= ?x ?y) (<= ?y ?x))
(&& (<= ?x ?y) (<= ?y ?x)) ==> (== ?x ?y)
(* (min ?x ?y) (max ?x ?y)) ==> (* ?x ?y)
(* ?x ?y) ==> (* (min ?x ?y) (max ?x ?y))
(&& (min ?x ?y) (max ?x ?y)) ==> (&& ?x ?y)
(&& ?x ?y) ==> (&& (min ?x ?y) (max ?x ?y))
(|| (min ?x ?y) (max ?x ?y)) ==> (|| ?x ?y)
(|| ?x ?y) ==> (|| (min ?x ?y) (max ?x ?y))
(^ (min ?x ?y) (max ?x ?y)) ==> (^ ?x ?y)
(^ ?x ?y) ==> (^ (min ?x ?y) (max ?x ?y))
(+ ?x (+ ?y ?z)) ==> (+ (+ ?x ?y) ?z)
(+ (+ ?x ?y) ?z) ==> (+ ?x (+ ?y ?z))
