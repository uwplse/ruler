(sin (/ PI 2)) ==> 1
1 ==> (sin (/ PI 2))
(cos (/ PI 2)) ==> 0
0 ==> (cos (/ PI 2))
(tan 0) ==> 0
0 ==> (tan 0)
(cos PI) ==> (- 1)
(- 1) ==> (cos PI)
(sin PI) ==> 0
0 ==> (sin PI)
(tan PI) ==> 0
0 ==> (tan PI)
(tan ?x) ==> (/ (sin ?x) (cos ?x))
(/ (sin ?x) (cos ?x)) ==> (tan ?x)
(sin (+ ?x PI)) ==> (- (sin ?x))
(- (sin ?x)) ==> (sin (+ ?x PI))
(cos (+ ?x PI)) ==> (- (cos ?x))
(- (cos ?x)) ==> (cos (+ ?x PI))
(sin (- ?x)) ==> (- (sin ?x))
(- (sin ?x)) ==> (sin (- ?x))
(cos (- ?x)) ==> (cos ?x)
(cos ?x) ==> (cos (- ?x))
(cos 0) ==> 1
1 ==> (cos 0)
