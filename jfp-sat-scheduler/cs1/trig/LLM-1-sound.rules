(tan ?x) ==> (/ (sin ?x) (cos ?x))
(/ (sin ?x) (cos ?x)) ==> (tan ?x)
(sin 0) ==> 0
0 ==> (sin 0)
(cos 0) ==> 1
1 ==> (cos 0)
(tan 0) ==> 0
0 ==> (tan 0)
(sin (/ PI 2)) ==> 1
1 ==> (sin (/ PI 2))
(cos (/ PI 2)) ==> 0
0 ==> (cos (/ PI 2))
(sin PI) ==> 0
0 ==> (sin PI)
(cos PI) ==> (- 1)
(- 1) ==> (cos PI)
(sin (- ?x)) ==> (- (sin ?x))
(- (sin ?x)) ==> (sin (- ?x))
(cos (- ?x)) ==> (cos ?x)
(cos ?x) ==> (cos (- ?x))
(sin (+ ?x PI)) ==> (- (sin ?x))
(- (sin ?x)) ==> (sin (+ ?x PI))
(cos (+ ?x PI)) ==> (- (cos ?x))
(- (cos ?x)) ==> (cos (+ ?x PI))
(sin (+ PI PI)) ==> 0
0 ==> (sin (+ PI PI))
(cos (+ PI PI)) ==> 1
1 ==> (cos (+ PI PI))
(tan (+ PI PI)) ==> 0
0 ==> (tan (+ PI PI))
(sin (+ PI (/ PI 2))) ==> (- 1)
(- 1) ==> (sin (+ PI (/ PI 2)))
(cos (+ PI (/ PI 2))) ==> 0
0 ==> (cos (+ PI (/ PI 2)))
(sin (+ PI (/ PI 6))) ==> (- (sin (/ PI 6)))
(- (sin (/ PI 6))) ==> (sin (+ PI (/ PI 6)))
(cos (+ PI (/ PI 6))) ==> (- (cos (/ PI 6)))
(- (cos (/ PI 6))) ==> (cos (+ PI (/ PI 6)))
(tan PI) ==> 0
0 ==> (tan PI)
(sin (* 2 PI)) ==> 0
0 ==> (sin (* 2 PI))
(cos (* 2 PI)) ==> 1
1 ==> (cos (* 2 PI))
(tan (* 2 PI)) ==> 0
0 ==> (tan (* 2 PI))
