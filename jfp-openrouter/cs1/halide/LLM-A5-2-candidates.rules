(select ?x 0 1) ==> (! ?x)
(! ?x) ==> (select ?x 0 1)
(select ?x ?x 0) ==> ?x
?x ==> (select ?x ?x 0)
(+ ?x (- ?x)) ==> 0
(+ ?w (select ?x ?y ?z)) ==> (select ?x (+ ?w ?y) (+ ?w ?z))
(select ?x (+ ?w ?y) (+ ?w ?z)) ==> (+ ?w (select ?x ?y ?z))
(* ?x 0) ==> 0
(&& ?x 0) ==> 0
(|| ?x 1) ==> 1
(+ (- ?x) ?x) ==> 0
(- ?x ?x) ==> 0
(- (+ ?x ?y)) ==> (+ (- ?x) (- ?y))
(+ (- ?x) (- ?y)) ==> (- (+ ?x ?y))
(min ?x (min ?x ?y)) ==> (min ?x ?y)
(min ?x ?y) ==> (min ?x (min ?x ?y))
(max ?x (max ?x ?y)) ==> (max ?x ?y)
(max ?x ?y) ==> (max ?x (max ?x ?y))
(<= (min ?x ?y) ?z) ==> (&& (<= ?x ?z) (<= ?y ?z))
(&& (<= ?x ?z) (<= ?y ?z)) ==> (<= (min ?x ?y) ?z)
(<= ?z (min ?x ?y)) ==> (&& (<= ?z ?x) (<= ?z ?y))
(&& (<= ?z ?x) (<= ?z ?y)) ==> (<= ?z (min ?x ?y))
(<= (max ?x ?y) ?z) ==> (&& (<= ?x ?z) (<= ?y ?z))
(&& (<= ?x ?z) (<= ?y ?z)) ==> (<= (max ?x ?y) ?z)
(<= ?z (max ?x ?y)) ==> (|| (<= ?z ?x) (<= ?z ?y))
(|| (<= ?z ?x) (<= ?z ?y)) ==> (<= ?z (max ?x ?y))
(< ?x ?y) ==> (<= (+ ?x 1) ?y)
(<= (+ ?x 1) ?y) ==> (< ?x ?y)
(<= ?x ?y) ==> (< ?x (+ ?y 1))
(< ?x (+ ?y 1)) ==> (<= ?x ?y)
(== (- ?x ?z) (- ?y ?z)) ==> (== ?x ?y)
(== ?a (! ?a)) ==> 0
(!= ?a (! ?a)) ==> 1
(&& ?x (&& ?x ?y)) ==> (&& ?x ?y)
(&& ?x ?y) ==> (&& ?x (&& ?x ?y))
(|| ?x (|| ?x ?y)) ==> (|| ?x ?y)
(|| ?x ?y) ==> (|| ?x (|| ?x ?y))
(&& ?a (|| ?a ?b)) ==> (&& ?a ?a)
