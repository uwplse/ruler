(max 1 ?x) ==> (select (<= ?x 1) 1 ?x)
(select (<= ?x 1) 1 ?x) ==> (max 1 ?x)
(* 0 ?x) ==> 0
(&& 0 ?x) ==> 0
(|| 1 ?x) ==> 1
(select ?c (/ ?x ?y) (/ ?x ?z)) ==> (/ ?x (select ?c ?y ?z))
(/ ?x (select ?c ?y ?z)) ==> (select ?c (/ ?x ?y) (/ ?x ?z))
(select ?c (< ?x ?y) (< ?x ?z)) ==> (< ?x (select ?c ?y ?z))
(< ?x (select ?c ?y ?z)) ==> (select ?c (< ?x ?y) (< ?x ?z))
(select ?c (^ ?a ?x) (^ ?b ?x)) ==> (^ (select ?c ?a ?b) ?x)
(^ (select ?c ?a ?b) ?x) ==> (select ?c (^ ?a ?x) (^ ?b ?x))
(select ?c (&& ?a ?x) (&& ?b ?x)) ==> (&& (select ?c ?a ?b) ?x)
(&& (select ?c ?a ?b) ?x) ==> (select ?c (&& ?a ?x) (&& ?b ?x))
(|| (select ?c ?a ?b) ?x) ==> (select ?c (|| ?a ?x) (|| ?b ?x))
(select ?c (|| ?a ?x) (|| ?b ?x)) ==> (|| (select ?c ?a ?b) ?x)
(select ?c (< ?a ?x) (< ?b ?x)) ==> (< (select ?c ?a ?b) ?x)
(< (select ?c ?a ?b) ?x) ==> (select ?c (< ?a ?x) (< ?b ?x))
