(- (select ?x ?y ?z)) ==> (select ?x (- ?y) (- ?z))
(select ?x (- ?y) (- ?z)) ==> (- (select ?x ?y ?z))
(- ?x (select ?y ?z ?w)) ==> (select ?y (- ?x ?z) (- ?x ?w))
(select ?y (- ?x ?z) (- ?x ?w)) ==> (- ?x (select ?y ?z ?w))
(- (max ?x ?y)) ==> (min (- ?x) (- ?y))
(min (- ?x) (- ?y)) ==> (- (max ?x ?y))
(- (min ?x ?y)) ==> (max (- ?x) (- ?y))
(max (- ?x) (- ?y)) ==> (- (min ?x ?y))
(* 0 ?x) ==> 0
(&& 0 ?x) ==> 0
(|| ?x (! ?x)) ==> 1
(^ ?x (! ?x)) ==> 1
(select ?x 1 0) ==> (&& ?x ?x)
(&& ?x ?x) ==> (select ?x 1 0)
(select ?x ?y 0) ==> (* ?y (&& ?x ?x))
(* ?y (&& ?x ?x)) ==> (select ?x ?y 0)
(- (+ ?x ?y)) ==> (+ (- ?x) (- ?y))
(+ (- ?x) (- ?y)) ==> (- (+ ?x ?y))
(+ (- ?x ?y) ?y) ==> ?x
(- (+ ?x ?y) ?x) ==> ?y
(- (+ ?x ?y) ?y) ==> ?x
(< ?x ?y) ==> (< (- ?x ?y) 0)
(< (- ?x ?y) 0) ==> (< ?x ?y)
(<= ?x ?y) ==> (<= (- ?x ?y) 0)
(<= (- ?x ?y) 0) ==> (<= ?x ?y)
(== ?x ?y) ==> (== (- ?x ?y) 0)
(== (- ?x ?y) 0) ==> (== ?x ?y)
(!= ?x ?y) ==> (!= (- ?x ?y) 0)
(!= (- ?x ?y) 0) ==> (!= ?x ?y)
(+ (max ?a ?b) (min ?a ?b)) ==> (+ ?a ?b)
(+ ?a ?b) ==> (+ (max ?a ?b) (min ?a ?b))
