(!= (&& ?b ?a) 0) ==> (&& ?b ?a)
(&& ?b ?a) ==> (!= (&& ?b ?a) 0)
(!= (|| ?b ?a) 0) ==> (|| ?b ?a)
(|| ?b ?a) ==> (!= (|| ?b ?a) 0)
(!= (^ ?b ?a) 0) ==> (^ ?b ?a)
(^ ?b ?a) ==> (!= (^ ?b ?a) 0)
(- (+ ?x ?y) ?y) ==> ?x
(+ (- ?x ?y) ?y) ==> ?x
(<= (+ ?x ?z) (+ ?y ?z)) ==> (<= ?x ?y)
(<= (- ?x ?z) (- ?y ?z)) ==> (<= ?x ?y)
(- ?x (select ?y ?z ?w)) ==> (select ?y (- ?x ?z) (- ?x ?w))
(select ?y (- ?x ?z) (- ?x ?w)) ==> (- ?x (select ?y ?z ?w))
