(!= ?a (! ?a)) ==> 1
(<= ?x ?y) ==> (< ?x (+ ?y 1))
(< ?x (+ ?y 1)) ==> (<= ?x ?y)
(&& ?x (&& ?x ?y)) ==> (&& ?x ?y)
(&& ?x ?y) ==> (&& ?x (&& ?x ?y))
(|| ?x (|| ?x ?y)) ==> (|| ?x ?y)
(|| ?x ?y) ==> (|| ?x (|| ?x ?y))
(+ ?w (select ?x ?y ?z)) ==> (select ?x (+ ?w ?y) (+ ?w ?z))
(select ?x (+ ?w ?y) (+ ?w ?z)) ==> (+ ?w (select ?x ?y ?z))
