(min ?a (< 0 ?a)) ==> (min ?a 1)
(min ?a 1) ==> (min ?a (< 0 ?a))
(min ?a (!= ?a 0)) ==> (min ?a 1)
(min ?a 1) ==> (min ?a (!= ?a 0))
(< ?x ?y) ==> (<= (+ ?x 1) ?y)
(<= (+ ?x 1) ?y) ==> (< ?x ?y)
(<= ?x ?y) ==> (|| (< ?x ?y) (== ?x ?y))
(|| (< ?x ?y) (== ?x ?y)) ==> (<= ?x ?y)
(!= ?x ?y) ==> (|| (< ?x ?y) (< ?y ?x))
(|| (< ?x ?y) (< ?y ?x)) ==> (!= ?x ?y)
(< (+ ?x ?z) (+ ?y ?z)) ==> (< ?x ?y)
(select (! ?x) ?y ?z) ==> (select ?x ?z ?y)
(select ?x ?z ?y) ==> (select (! ?x) ?y ?z)
