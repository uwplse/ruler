    "(select (!= ?x ?y) ?y ?x) ==> ?y",
    "(max ?x ?y) ==> (select (< ?x ?y) ?y ?x)",
    "(select (< ?x ?y) ?y ?x) ==> (max ?x ?y)",
    "(min ?x ?y) ==> (select (< ?x ?y) ?x ?y)",
    "(select (< ?x ?y) ?x ?y) ==> (min ?x ?y)",
    "(!= ?x ?y) ==> (!= (max ?x ?y) (min ?x ?y))",
    "(!= (max ?x ?y) (min ?x ?y)) ==> (!= ?x ?y)"
  ]
}
