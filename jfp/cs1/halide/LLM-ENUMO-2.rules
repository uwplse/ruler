(<= ?x ?y) ==> (< ?x (+ ?y 1))
(< ?x (+ ?y 1)) ==> (<= ?x ?y)
(== (&& ?b ?a) 1) ==> (&& ?b ?a)
(&& ?b ?a) ==> (== (&& ?b ?a) 1)
(== (|| ?b ?a) 1) ==> (|| ?b ?a)
(|| ?b ?a) ==> (== (|| ?b ?a) 1)
(!= ?x ?y) ==> (|| (< ?x ?y) (< ?y ?x))
(|| (< ?x ?y) (< ?y ?x)) ==> (!= ?x ?y)
(+ (- ?x ?y) ?y) ==> ?x
(< (max ?x ?y) ?z) ==> (&& (< ?x ?z) (< ?y ?z))
(&& (< ?x ?z) (< ?y ?z)) ==> (< (max ?x ?y) ?z)
(- (min ?x ?y) ?z) ==> (min (- ?x ?z) (- ?y ?z))
(min (- ?x ?z) (- ?y ?z)) ==> (- (min ?x ?y) ?z)
