(exp 0) ==> 1
1 ==> (exp 0)
(pow ?x 1) ==> ?x
?x ==> (pow ?x 1)
(log (* ?x ?y)) ==> (+ (log ?x) (log ?y))
(+ (log ?x) (log ?y)) ==> (log (* ?x ?y))
(log (/ ?x ?y)) ==> (- (log ?x) (log ?y))
(- (log ?x) (log ?y)) ==> (log (/ ?x ?y))
(exp (- ?x ?y)) ==> (/ (exp ?x) (exp ?y))
(/ (exp ?x) (exp ?y)) ==> (exp (- ?x ?y))
(pow ?x (+ ?y ?z)) ==> (* (pow ?x ?y) (pow ?x ?z))
(* (pow ?x ?y) (pow ?x ?z)) ==> (pow ?x (+ ?y ?z))
(pow (* ?x ?y) ?z) ==> (* (pow ?x ?z) (pow ?y ?z))
(* (pow ?x ?z) (pow ?y ?z)) ==> (pow (* ?x ?y) ?z)
(pow (/ ?x ?y) ?z) ==> (/ (pow ?x ?z) (pow ?y ?z))
(/ (pow ?x ?z) (pow ?y ?z)) ==> (pow (/ ?x ?y) ?z)
(cbrt (- ?x)) ==> (- (cbrt ?x))
(- (cbrt ?x)) ==> (cbrt (- ?x))
(sqrt (* ?x ?y)) ==> (* (sqrt ?x) (sqrt ?y))
(* (sqrt ?x) (sqrt ?y)) ==> (sqrt (* ?x ?y))
(sqrt (/ ?x ?y)) ==> (/ (sqrt ?x) (sqrt ?y))
(/ (sqrt ?x) (sqrt ?y)) ==> (sqrt (/ ?x ?y))
(cbrt (* ?x ?y)) ==> (* (cbrt ?x) (cbrt ?y))
(* (cbrt ?x) (cbrt ?y)) ==> (cbrt (* ?x ?y))
(cbrt (/ ?x ?y)) ==> (/ (cbrt ?x) (cbrt ?y))
(/ (cbrt ?x) (cbrt ?y)) ==> (cbrt (/ ?x ?y))
(pow (exp ?x) ?y) ==> (exp (* ?y ?x))
(exp (* ?y ?x)) ==> (pow (exp ?x) ?y)
(sqrt (exp ?x)) ==> (exp (/ ?x 2))
(exp (/ ?x 2)) ==> (sqrt (exp ?x))
(cbrt (exp ?x)) ==> (exp (/ ?x 3))
(exp (/ ?x 3)) ==> (cbrt (exp ?x))
(log (sqrt ?x)) ==> (/ (log ?x) 2)
(/ (log ?x) 2) ==> (log (sqrt ?x))
(log (cbrt ?x)) ==> (/ (log ?x) 3)
(/ (log ?x) 3) ==> (log (cbrt ?x))
(pow (sqrt ?x) 2) ==> ?x
?x ==> (pow (sqrt ?x) 2)
(pow (cbrt ?x) 3) ==> ?x
?x ==> (pow (cbrt ?x) 3)
(cbrt (pow ?x 3)) ==> ?x
?x ==> (cbrt (pow ?x 3))
(sqrt ?x) ==> (pow ?x (/ 1 2))
(pow ?x (/ 1 2)) ==> (sqrt ?x)
(cbrt ?x) ==> (pow ?x (/ 1 3))
(pow ?x (/ 1 3)) ==> (cbrt ?x)
