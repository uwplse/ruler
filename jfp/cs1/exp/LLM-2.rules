(log 1) ==> 0
0 ==> (log 1)
(sqrt 1) ==> 1
1 ==> (sqrt 1)
(cbrt 1) ==> 1
1 ==> (cbrt 1)
(pow ?x 0) ==> 1
(pow 1 ?x) ==> 1
(exp (- ?x)) ==> (/ 1 (exp ?x))
(/ 1 (exp ?x)) ==> (exp (- ?x))
(pow ?x 2) ==> (* ?x ?x)
(* ?x ?x) ==> (pow ?x 2)
(log (exp ?x)) ==> ?x
?x ==> (log (exp ?x))
(exp (log ?x)) ==> ?x
?x ==> (exp (log ?x))
(pow ?x (- ?y)) ==> (/ 1 (pow ?x ?y))
(/ 1 (pow ?x ?y)) ==> (pow ?x (- ?y))
(exp (+ ?x ?y)) ==> (* (exp ?x) (exp ?y))
(* (exp ?x) (exp ?y)) ==> (exp (+ ?x ?y))
(pow ?x ?y) ==> (exp (* ?y (log ?x)))
(exp (* ?y (log ?x))) ==> (pow ?x ?y)
(log (pow ?x ?y)) ==> (* ?y (log ?x))
(* ?y (log ?x)) ==> (log (pow ?x ?y))
(pow (exp ?x) ?y) ==> (exp (* ?x ?y))
(exp (* ?x ?y)) ==> (pow (exp ?x) ?y)
(pow (pow ?x ?y) ?z) ==> (pow ?x (* ?y ?z))
(pow ?x (* ?y ?z)) ==> (pow (pow ?x ?y) ?z)
(cbrt (sqrt ?x)) ==> (sqrt (cbrt ?x))
(sqrt (cbrt ?x)) ==> (cbrt (sqrt ?x))
(pow ?x (+ ?y ?z)) ==> (* (pow ?x ?y) (pow ?x ?z))
(* (pow ?x ?y) (pow ?x ?z)) ==> (pow ?x (+ ?y ?z))
