(exp 0) ==> 1
1 ==> (exp 0)
(pow ?x 1) ==> ?x
?x ==> (pow ?x 1)
(log (/ 1 ?x)) ==> (- (log ?x))
(- (log ?x)) ==> (log (/ 1 ?x))
(pow ?x (+ ?y ?z)) ==> (* (pow ?x ?y) (pow ?x ?z))
(* (pow ?x ?y) (pow ?x ?z)) ==> (pow ?x (+ ?y ?z))
(cbrt (sqrt ?x)) ==> (sqrt (cbrt ?x))
(sqrt (cbrt ?x)) ==> (cbrt (sqrt ?x))
