(exp 0) ==> 1
1 ==> (exp 0)
(pow ?x 1) ==> ?x
?x ==> (pow ?x 1)
(exp (- ?x)) ==> (/ 1 (exp ?x))
(/ 1 (exp ?x)) ==> (exp (- ?x))
(pow ?x (+ ?y ?z)) ==> (* (pow ?x ?y) (pow ?x ?z))
(* (pow ?x ?y) (pow ?x ?z)) ==> (pow ?x (+ ?y ?z))
(pow ?x (- 1)) ==> (/ 1 ?x)
(/ 1 ?x) ==> (pow ?x (- 1))
(pow ?x (+ ?a ?b)) ==> (* (pow ?x ?a) (pow ?x ?b))
(* (pow ?x ?a) (pow ?x ?b)) ==> (pow ?x (+ ?a ?b))
(cbrt (/ 1 ?x)) ==> (/ 1 (cbrt ?x))
(/ 1 (cbrt ?x)) ==> (cbrt (/ 1 ?x))
