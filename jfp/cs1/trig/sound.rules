(tan (* 2 PI)) ==> 0
0 ==> (tan (* 2 PI))
(tan ?x) ==> (/ (sin ?x) (cos ?x))
(/ (sin ?x) (cos ?x)) ==> (tan ?x)
(sin (- ?x)) ==> (- (sin ?x))
(- (sin ?x)) ==> (sin (- ?x))
(cos (- ?x)) ==> (cos ?x)
(cos ?x) ==> (cos (- ?x))
(sin (+ ?x (* 2 PI))) ==> (sin ?x)
