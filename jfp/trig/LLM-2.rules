(sin (/ PI 2)) ==> 1
1 ==> (sin (/ PI 2))
(cos (/ PI 2)) ==> 0
0 ==> (cos (/ PI 2))
(cos (- x (/ PI 2))) ==> (sin x)
(sin x) ==> (cos (- x (/ PI 2)))
(cos PI) ==> -1
-1 ==> (cos PI)
(tan PI) ==> 0
0 ==> (tan PI)
(sin (+ ?x (* 2 PI))) ==> (sin ?x)
(sin ?x) ==> (sin (+ ?x (* 2 PI)))
(cos (+ ?x (* 2 PI))) ==> (cos ?x)
(cos ?x) ==> (cos (+ ?x (* 2 PI)))
(sqr (sin ?x)) ==> (* (sin ?x) (sin ?x))
(* (sin ?x) (sin ?x)) ==> (sqr (sin ?x))
(sqr (cos ?x)) ==> (* (cos ?x) (cos ?x))
(* (cos ?x) (cos ?x)) ==> (sqr (cos ?x))
(sqr (tan ?x)) ==> (* (tan ?x) (tan ?x))
(* (tan ?x) (tan ?x)) ==> (sqr (tan ?x))
(tan ?x) ==> (/ (sin ?x) (cos ?x))
(/ (sin ?x) (cos ?x)) ==> (tan ?x)
(sin (sqr ?x)) ==> (sin (* ?x ?x))
(sin (* ?x ?x)) ==> (sin (sqr ?x))
(cos (sqr ?x)) ==> (cos (* ?x ?x))
(cos (* ?x ?x)) ==> (cos (sqr ?x))
(tan (sqr ?x)) ==> (tan (* ?x ?x))
(tan (* ?x ?x)) ==> (tan (sqr ?x))
(cos (- PI ?x)) ==> (- (cos ?x))
(- (cos ?x)) ==> (cos (- PI ?x))
(sin (- PI ?x)) ==> (sin ?x)
(sin ?x) ==> (sin (- PI ?x))
(sin (- ?x)) ==> (- (sin ?x))
(- (sin ?x)) ==> (sin (- ?x))
(cos (- ?x)) ==> (cos ?x)
(cos ?x) ==> (cos (- ?x))
(sin (- ?x (/ PI 2))) ==> (- (cos ?x))
(- (cos ?x)) ==> (sin (- ?x (/ PI 2)))
(cos (- ?x PI)) ==> (- (cos ?x))
(- (cos ?x)) ==> (cos (- ?x PI))
